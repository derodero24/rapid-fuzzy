{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": ["develop"],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "ignoreDeps": ["string-similarity", "@types/string-similarity"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Automerge non-major devDependency updates",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Automerge minor/patch updates of the pinned pnpm version (package.json packageManager)",
      "matchDepTypes": ["packageManager"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Pin GitHub Actions digests and automerge non-major updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "pinDigests": true,
      "automerge": true
    },
    {
      "description": "Skip stability wait for github-actions digest pins (no releaseTimestamp)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "The pnpm-workspace.yaml overrides are security floors that must stay within the major their dependents ask for (see the comment there): never propose a major bump",
      "matchFileNames": ["pnpm-workspace.yaml"],
      "matchDepTypes": ["pnpm-workspace.overrides"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Group Rust crate updates",
      "matchManagers": ["cargo"],
      "groupName": "rust-dependencies"
    },
    {
      "description": "Automerge non-major Rust crate updates",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Keep the napi-rs toolchain in lockstep: napi-build exports symbols that only exist in matching emnapi archives, and @napi-rs/cli regenerates the loader files",
      "matchPackageNames": [
        "napi",
        "napi-build",
        "napi-derive",
        "@napi-rs/cli",
        "emnapi",
        "@emnapi/core",
        "@emnapi/runtime"
      ],
      "groupName": "napi-rs toolchain",
      "automerge": false
    },
    {
      "description": "Bump the biome.json $schema URL together with @biomejs/biome",
      "matchPackageNames": ["@biomejs/biome"],
      "groupName": "biome"
    },
    {
      "description": "A binaryen bump must refresh the pinned archive checksum too (the command is allowed in .github/workflows/renovate.yml)",
      "matchDepNames": ["WebAssembly/binaryen"],
      "postUpgradeTasks": {
        "commands": ["node .github/scripts/update-binaryen-sha256.cjs"],
        "fileFilters": ["scripts/install-binaryen.sh"],
        "executionMode": "update"
      }
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "biome.json $schema URL carries the Biome version",
      "managerFilePatterns": ["/^biome\\.json$/"],
      "matchStrings": ["https://biomejs\\.dev/schemas/(?<currentValue>[^/]+)/schema\\.json"],
      "depNameTemplate": "@biomejs/biome",
      "depTypeTemplate": "devDependencies",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Pinned binaryen release installed in CI",
      "managerFilePatterns": ["/^scripts/install-binaryen\\.sh$/"],
      "matchStrings": ["BINARYEN_VERSION=\"(?<currentValue>version_\\d+)\""],
      "depNameTemplate": "WebAssembly/binaryen",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^version_(?<major>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "npm CLI pinned in the release workflow (npm trusted publishing needs 11.5.1 or later)",
      "managerFilePatterns": ["/^\\.github/workflows/release\\.yml$/"],
      "matchStrings": ["NPM_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "npm",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Codecov CLI release pinned through codecov/codecov-action's version input",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["version: (?<currentValue>v\\d+\\.\\d+\\.\\d+) # codecov-cli"],
      "depNameTemplate": "codecov/codecov-cli",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Tool versions installed with taiki-e/install-action in workflows",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["tool: (?<depName>[a-z0-9-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "crate"
    }
  ]
}
