{
  "name": "rapid-fuzzy",
  "version": "2.1.1",
  "description": "Rust-powered fuzzy search and string distance for JavaScript/TypeScript, with native Node.js bindings and a WebAssembly build for browsers, Deno and Workers.",
  "license": "MIT",
  "author": "derodero24",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derodero24/rapid-fuzzy.git"
  },
  "homepage": "https://github.com/derodero24/rapid-fuzzy",
  "bugs": {
    "url": "https://github.com/derodero24/rapid-fuzzy/issues"
  },
  "keywords": [
    "fuzzy",
    "fuzzy-search",
    "fuzzy-matching",
    "string-distance",
    "string-similarity",
    "levenshtein",
    "jaro-winkler",
    "hamming",
    "damerau-levenshtein",
    "rust",
    "napi-rs",
    "wasm",
    "typescript",
    "search",
    "fuse"
  ],
  "sideEffects": [
    "./index.js",
    "./index.mjs",
    "./browser.mjs",
    "./workerd.mjs"
  ],
  "type": "commonjs",
  "main": "index.js",
  "browser": "./browser.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "workerd": {
        "types": "./browser.d.mts",
        "default": "./workerd.mjs"
      },
      "browser": {
        "require": {
          "types": "./index.d.ts",
          "default": "./index.js"
        },
        "default": {
          "types": "./browser.d.mts",
          "default": "./browser.mjs"
        }
      },
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "default": {
        "types": "./browser.d.mts",
        "default": "./browser.mjs"
      }
    },
    "./highlight": {
      "workerd": {
        "types": "./highlight.d.mts",
        "default": "./highlight.browser.mjs"
      },
      "browser": {
        "require": {
          "types": "./highlight.d.ts",
          "default": "./highlight.js"
        },
        "default": {
          "types": "./highlight.d.mts",
          "default": "./highlight.browser.mjs"
        }
      },
      "import": {
        "types": "./highlight.d.mts",
        "default": "./highlight.mjs"
      },
      "require": {
        "types": "./highlight.d.ts",
        "default": "./highlight.js"
      },
      "default": {
        "types": "./highlight.d.mts",
        "default": "./highlight.browser.mjs"
      }
    },
    "./objects": {
      "workerd": {
        "types": "./objects.browser.d.mts",
        "default": "./workerd.mjs"
      },
      "browser": {
        "require": {
          "types": "./objects.d.ts",
          "default": "./objects.js"
        },
        "default": {
          "types": "./objects.browser.d.mts",
          "default": "./browser.mjs"
        }
      },
      "import": {
        "types": "./objects.d.mts",
        "default": "./objects.mjs"
      },
      "require": {
        "types": "./objects.d.ts",
        "default": "./objects.js"
      },
      "default": {
        "types": "./objects.browser.d.mts",
        "default": "./browser.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "index.d.mts",
    "objects.js",
    "objects.mjs",
    "objects.d.ts",
    "browser.mjs",
    "browser.d.mts",
    "browser-api.mjs",
    "workerd.mjs",
    "highlight.js",
    "highlight.mjs",
    "highlight.d.ts",
    "highlight.d.mts",
    "objects.d.mts",
    "highlight.browser.mjs",
    "objects.browser.mjs",
    "objects.browser.d.mts",
    "rapid-fuzzy-wasm-bindgen.mjs",
    "rapid-fuzzy-wasm-bindgen_bg.wasm",
    "rapid-fuzzy-wasm-bindgen.d.mts",
    "THIRD_PARTY_NOTICES"
  ],
  "napi": {
    "binaryName": "rapid-fuzzy",
    "constEnum": false,
    "runtimeStringEnum": true,
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "wasm32-wasip1-threads"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.8.2",
  "scripts": {
    "build": "napi build --manifest-path crates/core/Cargo.toml --platform --release --js index.js --dts index.d.ts --output-dir .",
    "postbuild": "node scripts/patch-binding.js",
    "build:debug": "napi build --manifest-path crates/core/Cargo.toml --platform --js index.js --dts index.d.ts --output-dir .",
    "build:wasm": "napi build --manifest-path crates/core/Cargo.toml --platform --release --js index.js --dts index.d.ts --output-dir . --target wasm32-wasip1-threads",
    "postbuild:wasm": "node scripts/optimize-wasm.js && node scripts/patch-binding.js",
    "build:wasm-bindgen": "node scripts/build-wasm-bindgen.js",
    "postbuild:wasm-bindgen": "node scripts/optimize-wasm.js",
    "build:browser": "node scripts/build-browser.js",
    "optimize:wasm": "node scripts/optimize-wasm.js",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version",
    "changeset:version": "pnpm changeset version && node scripts/sync-cargo-version.js && napi version && pnpm run build && pnpm exec biome format --write npm/",
    "check": "biome ci",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:wasm": "vitest run __test__/wasm.spec.ts",
    "test:browser": "playwright test",
    "test:bun": "bun test --conditions=browser e2e/wasm-bun.test.ts",
    "test:deno": "deno test --conditions=browser --allow-read --allow-env --allow-net --node-modules-dir=auto --no-check e2e/wasm-deno.test.ts",
    "test:watch": "vitest watch",
    "bench": "vitest bench",
    "bench:ci": "vitest bench __test__/distance.bench.ts __test__/similarity.bench.ts __test__/ratio.bench.ts __test__/batch.bench.ts __test__/search.bench.ts",
    "bench:readme": "npx tsx scripts/update-bench-readme.ts",
    "bench:charts": "npx tsx scripts/generate-bench-charts.ts",
    "publint": "publint",
    "bench:rust": "cargo bench -p rapid-fuzzy-bench",
    "notices": "cargo fetch --locked && node scripts/third-party-notices.js",
    "verify": "pnpm run check && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && pnpm run build && pnpm run typecheck && pnpm test",
    "clean": "rm -rf target coverage *.node *.wasm",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@changesets/cli": "^3.0.2",
    "@codspeed/vitest-plugin": "^5.7.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@emnapi/core": "2.0.0-alpha.5",
    "@emnapi/runtime": "2.0.0-alpha.5",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@napi-rs/cli": "^3.9.1",
    "@napi-rs/wasm-runtime": "^1.1.6",
    "@playwright/test": "^1.61.1",
    "@tybys/wasm-util": "^0.10.3",
    "@types/node": "^24.13.2",
    "@types/string-similarity": "^4.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "emnapi": "2.0.0-alpha.5",
    "fastest-levenshtein": "^1.0.16",
    "flexsearch": "^0.8.212",
    "fuse.js": "^7.1.0",
    "fuzzball": "^2.2.3",
    "fuzzysort": "^4.0.2",
    "lefthook": "^2.1.4",
    "leven": "^4.1.0",
    "minisearch": "^7.2.0",
    "publint": "^0.3.18",
    "string-similarity": "^4.0.4",
    "typescript": "^7.0.0",
    "vite": "^8.1.4",
    "vitest": "^5.0.0"
  }
}
