# Dependencies
node_modules/

# Build outputs
target/
dist/
*.node

# napi-rs generated files (tracked via git add -f for npm package)
# Biome ignores these via useIgnoreFile
index.js
index.d.ts
browser.js

# wasm-bindgen generated files (tracked via git add -f for npm package)
rapid-fuzzy-wasm-bindgen.mjs
rapid-fuzzy-wasm-bindgen.d.mts

# Browser / edge entry points generated by scripts/build-browser.js
# (tracked via git add -f for npm package)
browser.mjs
browser.d.mts
browser-api.mjs
workerd.mjs
highlight.browser.mjs
objects.browser.mjs
objects.browser.d.mts

# napi-rs generated binaries (build output)
*.wasm
*.wasi.cjs
*.wasi-browser.js
*.wasi.d.cts
wasi-worker.mjs
wasi-worker-browser.mjs

# napi-rs platform package binaries are ignored by *.node / *.wasm patterns above
# Only npm/*/package.json files are tracked

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Coverage
coverage/
*.lcov

# Vitest reports (JSON report, attachments, blobs)
.vitest/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.*

# Internal docs (local only, except migration guides)
docs/*
!docs/migration/

# Claude Code (local development only)
CLAUDE.md
.claude/
test-results
deno.lock
